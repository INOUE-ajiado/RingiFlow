rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // 基本設計書 4.2節に基づく方針
    //
    // 稟議データは金額を含む社内機密であり、また状態の不整合を防ぐ必要がある。
    // そのためクライアントSDK（Angular）からの直接アクセスは
    // 読み取り・書き込みともに全面禁止とする。
    //
    // users / ringi_requests / audit_logs のすべてのデータ取得・更新は
    // Go バックエンドAPI（Firebase Admin SDK）経由でのみ実施する。
    // Admin SDK は本ルールの評価対象外であるため影響を受けない。
    //
    // 閲覧範囲（自身の申請 / 自身が承認すべき稟議）の絞り込みは
    // Go API 側で必ず実施すること。
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
